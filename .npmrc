# 使用国内镜像加速依赖下载
registry=https://registry.npmmirror.com

# 常用二进制镜像（本项目核心依赖）
electron-mirror=https://npmmirror.com/mirrors/electron/
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
better-sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3

# 历史项目依赖兼容：保留 hoist 行为，避免安装结构变化带来回归
shamefully-hoist=true

# 使用扁平 node_modules（非符号链接），让 electron-builder 正确遍历 transitive
# 依赖。pnpm 默认的符号链接结构会导致打包时漏掉大量 transitive deps
# （如 ms、openai、@google/genai、@aws-sdk/*、proxy-agent 全家桶等）。
node-linker=hoisted
